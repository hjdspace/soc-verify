{
  "name": "socverify-runner-deps",
  "version": "0.0.0",
  "private": true,
  "description": "pi runner 生产依赖（issue 10）。extraResources 分发到 <resources>/runner-pi/node_modules，与根 package.json 的 devDependencies 保持同一套精确版本。由 scripts/prepare-runner-deps.mjs 以 npm ci 安装。",
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@juicesharp/rpiv-todo": "2.9.0",
    "jiti": "2.7.0",
    "pi-mcp-adapter": "2.32.1",
    "pi-subagents": "0.66.0",
    "pi-web-access": "0.29.0",
    "typebox": "1.3.7"
  },
  "overrides": {
    "pi-mcp-adapter": {
      "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
      "typebox": "$typebox"
    }
  }
}
